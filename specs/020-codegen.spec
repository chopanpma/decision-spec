decision GEN-007 "Fitness configs are emitted only for fully-mapped rels and never abort the toolchain" {
  status: accepted
  context: "F27 (verified against import-linter 2.5.2): a contract naming an unmapped container aborts the whole file, and sections must be spelled importlinter:contract:<id> or zero contracts evaluate. F9 (verified against dependency-cruiser 18.5.0): rules must forbid the to-side importing the from-side with segment-anchored paths or allowed imports fail and siblings false-positive."
  consequences: "+ the fitness row means something when green: contracts evaluated and paths anchored. - rels with an unmapped endpoint are only TODO comments, so their direction is unenforced until someone maps the container."
}

spec GEN-007 {
  requirement GEN-007-R1 (EARS) {
    text: "WHEN fitness artifacts are generated THEN an import-linter contract SHALL exist only when both containers are mapped, unmapped endpoints SHALL become TODOs, and dependency-cruiser rules SHALL forbid the to-side importing the from-side with segment-anchored paths"
    layers: [unit]
    scenarios: [importlinter_emits_contracts_only_for_python_mapped_rels, unmapped_containers_get_todos_instead_of_bogus_contracts, fitness_modules_use_configured_container_packages, fitness_contract_identity_survives_config_changes, depcruise_forbids_the_to_side_from_importing_the_from_side, depcruise_paths_are_segment_anchored_without_rejected_regex_constructs, depcruise_keeps_container_ids_as_filesystem_paths, depcruise_config_documents_that_paths_match_container_directories]
  }
  scenario importlinter_emits_contracts_only_for_python_mapped_rels {
    given: "rels with zero, one, or two mapped endpoints"
    when: "the .importlinter file is generated"
    then: "contracts exist only for fully mapped rels under importlinter: sections"
    # delegates: decispec-codegen tests::importlinter_emits_contracts_only_for_python_mapped_rels
  }
  scenario unmapped_containers_get_todos_instead_of_bogus_contracts {
    given: "a rel with an unmapped endpoint"
    when: "the .importlinter file is generated"
    then: "a TODO names the container to map and no contract references it"
    # delegates: decispec-codegen tests::unmapped_containers_get_todos_instead_of_bogus_contracts
  }
  scenario fitness_modules_use_configured_container_packages {
    given: "a [stack.fitness.packages] mapping"
    when: "contracts are generated"
    then: "modules use the configured dotted paths"
    # delegates: decispec-codegen tests::fitness_modules_use_configured_container_packages
  }
  scenario fitness_contract_identity_survives_config_changes {
    given: "a rel with mapped endpoints"
    when: "decispec.toml's package mapping is edited"
    then: "the contract section identity stays stable"
    # delegates: decispec-codegen tests::fitness_contract_identity_survives_config_changes
  }
  scenario depcruise_forbids_the_to_side_from_importing_the_from_side {
    given: "a rel a -> b"
    when: "the dependency-cruiser config is generated"
    then: "the forbidden direction is b importing a, asserted by side"
    # delegates: decispec-codegen tests::depcruise_forbids_the_to_side_from_importing_the_from_side
  }
  scenario depcruise_paths_are_segment_anchored_without_rejected_regex_constructs {
    given: "container ids as paths"
    when: "the dependency-cruiser config is generated"
    then: "paths are segment-anchored and free of constructs depcruise rejects as unsafe"
    # delegates: decispec-codegen tests::depcruise_paths_are_segment_anchored_without_rejected_regex_constructs
  }
  scenario depcruise_keeps_container_ids_as_filesystem_paths {
    given: "a JS/TS tree where a container is a directory"
    when: "the dependency-cruiser config is generated"
    then: "container ids stay filesystem path segments"
    # delegates: decispec-codegen tests::depcruise_keeps_container_ids_as_filesystem_paths
  }
  scenario depcruise_config_documents_that_paths_match_container_directories {
    given: "the generated dependency-cruiser config"
