# Codegen contract — prefix GEN.
# Every scenario delegates to the codegen/cli/ir Rust test that pins it (F29).

decision GEN-001 "Every generated artifact carries the do-not-edit header and regeneration is byte-identical" {
  status: accepted
  context: "README: 'Everything generated carries a GENERATED BY DECISIONSPEC header; regeneration is byte-identical.' The header is also the stale-sweep's deletion key (GEN-002), so its exact first-two-line shape is pinned by test."
  consequences: "+ agents and humans can tell generated from hand-written at a glance, and re-running gen is a no-op diff. - the header text is now a format contract: changing it invalidates every previously generated file's sweep key."
}

spec GEN-001 {
  requirement GEN-001-R1 (EARS) {
    text: "WHEN gen renders an artifact THEN the file SHALL start with the DecisionSpec do-not-edit header and re-rendering the same workspace SHALL be byte-identical"
    layers: [unit]
    scenarios: [generated_header_detection_matches_first_two_lines, regeneration_is_byte_identical]
  }
  scenario generated_header_detection_matches_first_two_lines {
    given: "any generated file"
    when: "the sweep checks whether it may delete the file"
    then: "the header is matched on its first two lines exactly"
    # delegates: decispec-codegen tests::generated_header_detection_matches_first_two_lines
  }
  scenario regeneration_is_byte_identical {
    given: "a rendered workspace"
    when: "render_all runs again on the same IR"
    then: "every artifact's bytes are unchanged"
    # delegates: decispec-codegen tests::regeneration_is_byte_identical
  }
}

decision GEN-002 "The sweep deletes only stale DecisionSpec artifacts and never creates managed directories" {
  status: accepted
  context: "README: gen 'removes stale artifacts whose spec item disappeared' and 'never touches tests/glue/'. F28 dogfood relies on this: edited spec ids must sweep their old files without endangering foreign files. The cli pins the end-to-end sweep and the absent-directory case."
  consequences: "+ deleting a spec item cleans up after itself, including in the dogfooded repo's own tests/generated. - a file that loses its header (hand edit) becomes foreign and is never swept, by design."
}

spec GEN-002 {
  requirement GEN-002-R1 (EARS) {
    text: "WHEN gen sweeps THEN it SHALL delete only files bearing the DecisionSpec header whose item no longer exists, leave foreign files untouched, and never create managed directories"
    layers: [unit]
    scenarios: [gen_removes_stale_artifacts_and_keeps_foreign_files, sweep_does_not_create_managed_dirs_when_absent]
  }
  scenario gen_removes_stale_artifacts_and_keeps_foreign_files {
    given: "an output tree with a stale generated file and a foreign file"
    when: "gen runs after its spec item disappeared"
    then: "the stale file is deleted and the foreign file remains"
    # delegates: decispec (cli) tests::gen_removes_stale_artifacts_and_keeps_foreign_files
  }
  scenario sweep_does_not_create_managed_dirs_when_absent {
    given: "a project where no artifacts were ever generated"
    when: "the sweep runs"
    then: "no managed directory is created just to sweep it"
    # delegates: decispec (cli) tests::sweep_does_not_create_managed_dirs_when_absent
  }
}

decision GEN-003 "Generated test artifacts embed the spec and item ids the gate matches on" {
  status: accepted
  context: "README 'Codegen mapping': pytest files, contract features, Playwright titles, and rust skeletons all carry the spec item id, sanitized through ir::names (ARCH-003), so gate matching is a name comparison. F6/F23 fixed the escaping half of this contract. F47 (2026-10-23, user tvgo retro: 86 false greens before TASH-515) amended the Playwright half: an unimplemented e2e stub is declared test.fixme so the toolchain reports <skipped> — paired with GATE-008 the row is honestly SKIPPED instead of a silent pass from an empty body."
  consequences: "+ the gate needs no out-of-band mapping from artifact to spec item. - the ids become public API: renaming a scenario changes generated test names and can break historical JUnit comparisons."
}

spec GEN-003 {
  requirement GEN-003-R1 (EARS) {
    text: "WHEN artifacts are generated for spec items THEN their file names, test names, and titles SHALL embed the spec and item ids as produced by ir::names"
    layers: [unit]
    scenarios: [pytest_files_embed_spec_and_item_ids, contract_feature_is_idempotent, playwright_spec_shape_is_pinned, playwright_stub_marks_fixme_not_silent_pass, rust_skeletons_emitted_only_for_rust_stack, contract_e2e_infra_fitness_artifacts, contract_and_e2e_names_survive_norm]
  }
  scenario pytest_files_embed_spec_and_item_ids {
    given: "a scenario on the unit layer"
    when: "its pytest file is generated"
    then: "the spec id and scenario id appear in the test function name"
    # delegates: decispec-codegen tests::pytest_files_embed_spec_and_item_ids
  }
  scenario contract_feature_is_idempotent {
    given: "a contract-layer scenario"
    when: "its feature file is generated twice"
    then: "the bytes are identical and the scenario name embeds the ids"
    # delegates: decispec-codegen tests::contract_feature_is_idempotent
  }
  scenario playwright_spec_shape_is_pinned {
    given: "an e2e-layer scenario"
    when: "its Playwright spec is generated"
    then: "the title embeds the spec and scenario ids in the pinned shape"
    # delegates: decispec-codegen tests::playwright_spec_shape_is_pinned
  }
  scenario playwright_stub_marks_fixme_not_silent_pass {
    given: "an e2e-layer scenario whose flow is not implemented yet"
    when: "its Playwright stub is generated"
    then: "the test is declared test.fixme so the toolchain reports it skipped instead of passing an empty body"
    # delegates: decispec-codegen tests::playwright_stub_marks_fixme_not_silent_pass
  }
  scenario rust_skeletons_emitted_only_for_rust_stack {
    given: "a workspace whose decispec.toml sets lang = rust"
    when: "unit artifacts are generated"
    then: "rstest-style skeletons appear under tests/generated/unit/rust and reference the glue path"
    # delegates: decispec-codegen tests::rust_skeletons_emitted_only_for_rust_stack
  }
  scenario contract_e2e_infra_fitness_artifacts {
    given: "scenarios on contract and e2e plus an infra policy"
    when: "artifacts are generated"
    then: "each layer's artifact set matches the documented mapping"
    # delegates: decispec-codegen tests::contract_e2e_infra_fitness_artifacts
  }
  scenario contract_and_e2e_names_survive_norm {
    given: "ids needing normalization"
    when: "contract and e2e names are produced and normalized"
    then: "the round trip preserves the matchable name"
    # delegates: decispec-ir tests::contract_and_e2e_names_survive_norm
  }
}

decision GEN-004 "Mermaid edge labels are plain ASCII; PlantUML keeps raw labels" {
  status: accepted
  context: "F19/F23 (user-reported, verified against mermaid.ink): GitHub's markdown pipeline decodes HTML entities before Mermaid parses, so only plain characters survive; the charset rule is now [A-Za-z0-9 ,./:-] with parens and pipes collapsed. PlantUML never needed the workaround."
  consequences: "+ diagrams render on GitHub without a 400 from Mermaid. - labels lose characters silently (parens become nothing, other punctuation becomes '-'), which can obscure a label's meaning."
}

spec GEN-004 {
  requirement GEN-004-R1 (EARS) {
    text: "WHEN a diagram edge label is rendered THEN Mermaid SHALL receive plain ASCII from the pinned charset and PlantUML SHALL keep the raw label"
    layers: [unit]
    scenarios: [mermaid_edge_labels_are_plain_ascii_only, mermaid_edge_labels_drop_parens, mermaid_edge_labels_replace_pipe, plantuml_edge_labels_keep_raw_parens]
  }
  scenario mermaid_edge_labels_are_plain_ascii_only {
    given: "a rel label with characters outside the allowed set"
    when: "the mermaid model is rendered"
    then: "the label is plain ASCII from the pinned charset"
    # delegates: decispec-codegen tests::mermaid_edge_labels_are_plain_ascii_only
  }
  scenario mermaid_edge_labels_drop_parens {
    given: "a rel label containing parentheses"
    when: "the mermaid model is rendered"
    then: "the parens are dropped, not entity-escaped"
    # delegates: decispec-codegen tests::mermaid_edge_labels_drop_parens
  }
  scenario mermaid_edge_labels_replace_pipe {
    given: "a rel label containing a pipe"
    when: "the mermaid model is rendered"
    then: "the pipe is replaced so the edge syntax stays parseable"
    # delegates: decispec-codegen tests::mermaid_edge_labels_replace_pipe
  }
  scenario plantuml_edge_labels_keep_raw_parens {
    given: "a rel label containing parentheses"
    when: "the PlantUML diagram is rendered"
    then: "the label is emitted raw"
    # delegates: decispec-codegen tests::plantuml_edge_labels_keep_raw_parens
  }
}

